<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/workout_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/workout_inset_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/workout_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/workout_progress_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:textColor="@color/secondary_text"
                    android:textSize="13sp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/muscle_group_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/muscle_chip_background"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:maxLines="2"
                    android:paddingStart="12dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="7dp"
                    android:textColor="@color/accent_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/workout_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="10dp"
                android:importantForAccessibility="no"
                android:max="20"
                android:progress="1"
                android:progressDrawable="@drawable/progress_track" />

            <TextView
                android:id="@+id/exercise_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityHeading="true"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="start"
                android:lineSpacingExtra="1dp"
                android:maxLines="3"
                android:textColor="@color/primary_text"
                android:textSize="23sp" />

            <TextView
                android:id="@+id/exercise_mode_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/hold_badge_background"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.12"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:text="@string/hold_badge"
                android:textColor="@color/rest_text"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/exercise_media_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:layout_weight="1"
            android:gravity="center"
            android:minHeight="@dimen/workout_media_min_height">

            <FrameLayout
                android:id="@+id/exercise_media_card"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_gravity="center"
                android:background="@drawable/media_card_background"
                android:padding="8dp">

                <VideoView
                    android:id="@+id/exercise_video"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/hold_frame_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/media_background"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <View
                    android:id="@+id/media_scrim"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/media_background" />

                <TextView
                    android:id="@+id/media_loading_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/media_loading"
                    android:textColor="@color/secondary_text"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/media_error_panel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/media_background"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/media_error"
                        android:textColor="@color/primary_text"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/media_retry_button"
                        style="@style/FluxQuietButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:text="@string/media_retry" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/workout_action_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/ready_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/phase_ready_background"
                android:gravity="center"
                android:minHeight="@dimen/ready_panel_min_height"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/FluxEyebrowText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/ready_label" />

                <Button
                    android:id="@+id/start_button"
                    style="@style/FluxPrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="68dp"
                    android:text="@string/start" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/countdown_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/phase_move_background"
                android:minHeight="@dimen/move_panel_min_height"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/FluxEyebrowText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/move_label" />

                    <Button
                        android:id="@+id/speed_up_button"
                        style="@style/FluxQuietButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:contentDescription="@string/skip_move_description"
                        android:text="@string/skip" />
                </LinearLayout>

                <TextView
                    android:id="@+id/countdown_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/countdown_initial"
                    android:textColor="@color/primary_text"
                    android:textSize="60sp" />

                <ProgressBar
                    android:id="@+id/countdown_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="8dp"
                    android:importantForAccessibility="no"
                    android:max="45"
                    android:progress="45"
                    android:progressDrawable="@drawable/progress_track" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rest_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/phase_rest_background"
                android:minHeight="@dimen/rest_panel_min_height"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.18"
                        android:text="@string/rest_label"
                        android:textColor="@color/rest_text"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/rest_skip_button"
                        style="@style/FluxQuietButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="@string/skip_rest_description"
                        android:text="@string/skip" />

                    <TextView
                        android:id="@+id/rest_countdown_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:text="@string/rest_initial"
                        android:textColor="@color/rest_text"
                        android:textSize="40sp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/rest_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="6dp"
                    android:importantForAccessibility="no"
                    android:max="15"
                    android:progress="15"
                    android:progressDrawable="@drawable/rest_progress_track" />

                <Button
                    android:id="@+id/keep_button"
                    style="@style/FluxKeepButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:contentDescription="@string/tap_to_keep_description"
                    android:minHeight="64dp"
                    android:text="@string/tap_to_keep" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
