<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/workout_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/workout_phase_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:layoutDirection="ltr"
        android:orientation="horizontal"
        android:visibility="gone">

        <View
            android:id="@+id/workout_phase_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/workout_phase_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/workout_inset_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/workout_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/workout_progress_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:minHeight="36dp"
                    android:textColor="@color/secondary_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/workout_group_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:background="@drawable/muscle_chip_background"
                    android:breakStrategy="balanced"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:hyphenationFrequency="none"
                    android:lineSpacingExtra="1dp"
                    android:maxLines="2"
                    android:minHeight="36dp"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:textColor="@color/accent_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/workout_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="6dp"
                android:importantForAccessibility="no"
                android:max="30"
                android:progress="1"
                android:progressDrawable="@drawable/progress_track" />

            <TextView
                android:id="@+id/exercise_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityHeading="true"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="start"
                android:lineSpacingExtra="1dp"
                android:maxLines="4"
                android:textColor="@color/primary_text"
                android:textSize="23sp" />

            <LinearLayout
                android:id="@+id/side_phase_preview"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:importantForAccessibility="yes"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/side_phase_label"
                    android:layout_width="132dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/exercise_execution_label_unilateral_background"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:letterSpacing="0.08"
                    android:textColor="@color/white"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>

        <FrameLayout
            android:id="@+id/exercise_media_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:layout_weight="1"
            android:gravity="center"
            android:minHeight="@dimen/workout_media_min_height">

            <FrameLayout
                android:id="@+id/exercise_media_card"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_gravity="center"
                android:background="@drawable/media_card_background"
                android:clipToOutline="true"
                android:elevation="5dp"
                android:outlineProvider="background"
                android:padding="4dp">

                <VideoView
                    android:id="@+id/exercise_video"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/hold_frame_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/media_background"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/exercise_mode_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="10dp"
                    android:background="@drawable/hold_badge_background"
                    android:elevation="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:importantForAccessibility="no"
                    android:letterSpacing="0.12"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="@string/hold_badge"
                    android:textColor="@color/rest_text"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <View
                    android:id="@+id/media_scrim"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/media_background" />

                <ProgressBar
                    android:id="@+id/media_loading_indicator"
                    style="?android:attr/progressBarStyleLarge"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/brand_graphite" />

                <LinearLayout
                    android:id="@+id/media_error_panel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/media_background"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/media_error"
                        android:textColor="@color/primary_text"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/media_retry_button"
                        style="@style/FluxQuietButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:text="@string/media_retry" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/workout_action_host"
            android:layout_width="match_parent"
            android:layout_height="@dimen/workout_action_height">

            <LinearLayout
                android:id="@+id/ready_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/phase_ready_background"
                android:gravity="center"
                android:minHeight="@dimen/ready_panel_min_height"
                android:orientation="vertical"
                android:padding="12dp">

                <Button
                    android:id="@+id/start_button"
                    style="@style/FluxPrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="68dp"
                    android:maxLines="2"
                    android:text="@string/start" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/countdown_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:minHeight="@dimen/move_panel_min_height"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/countdown_phase_icon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/move_label"
                        android:importantForAccessibility="no"
                        android:scaleType="fitStart"
                        android:src="@drawable/ic_phase_active"
                        android:tint="@color/move_text" />

                    <TextView
                        android:id="@+id/skip_action"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/skip_move_description"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:minWidth="48dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/skip"
                        android:textColor="@color/move_text"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/countdown_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/countdown_initial"
                    android:textColor="@color/move_text"
                    android:textSize="60sp" />

                <ProgressBar
                    android:id="@+id/countdown_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="8dp"
                    android:importantForAccessibility="no"
                    android:max="45000"
                    android:progress="45000"
                    android:progressDrawable="@drawable/move_progress_track" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rest_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:minHeight="@dimen/rest_panel_min_height"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/rest_label"
                        android:importantForAccessibility="no"
                        android:scaleType="fitStart"
                        android:src="@drawable/ic_phase_pause"
                        android:tint="@color/rest_text" />

                    <TextView
                        android:id="@+id/rest_countdown_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/rest_initial"
                        android:textColor="@color/rest_text"
                        android:textSize="40sp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/rest_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="4dp"
                    android:importantForAccessibility="no"
                    android:max="15000"
                    android:progress="15000"
                    android:progressDrawable="@drawable/rest_progress_track" />

                <Button
                    android:id="@+id/keep_button"
                    style="@style/FluxKeepButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:contentDescription="@string/tap_to_keep_description"
                    android:minHeight="60dp"
                    android:maxLines="2"
                    android:text="@string/tap_to_keep" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
