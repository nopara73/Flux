<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/duration_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background">

    <LinearLayout
        android:id="@+id/duration_inset_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:id="@+id/duration_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/flux_appicon" />

                <FrameLayout
                    android:layout_width="250dp"
                    android:layout_height="250dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/duration_dial_background">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/duration_minutes_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:accessibilityLiveRegion="polite"
                            android:contentDescription="@string/duration_value_default_description"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:text="@string/duration_minutes_default"
                            android:textColor="@color/primary_text"
                            android:textSize="108sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="-6dp"
                            android:fontFamily="sans-serif-medium"
                            android:importantForAccessibility="no"
                            android:letterSpacing="0.18"
                            android:text="@string/duration_minutes_unit"
                            android:textColor="@color/accent_text"
                            android:textSize="13sp" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/duration_decrease_button"
                        style="@style/DurationStepButton"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:contentDescription="@string/duration_decrease_description"
                        android:text="@string/duration_decrease" />

                    <SeekBar
                        android:id="@+id/duration_seek_bar"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/duration_seek_description_default"
                        android:max="17"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:progress="7"
                        android:progressBackgroundTint="@color/route_inactive"
                        android:progressTint="@color/accent"
                        android:splitTrack="false"
                        android:thumbTint="@color/accent" />

                    <Button
                        android:id="@+id/duration_increase_button"
                        style="@style/DurationStepButton"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:contentDescription="@string/duration_increase_description"
                        android:text="@string/duration_increase" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="74dp"
                    android:paddingEnd="74dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/duration_minimum_value"
                        android:textColor="@color/secondary_text"
                        android:textSize="12sp" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/duration_maximum_value"
                        android:textColor="@color/secondary_text"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/duration_route_segments"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:layout_marginTop="36dp"
                    android:baselineAligned="false"
                    android:contentDescription="@string/duration_route_default_description"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View android:id="@+id/duration_segment_01" style="@style/DurationRouteSegmentActive" />
                    <View android:id="@+id/duration_segment_02" style="@style/DurationRouteSegmentActive" />
                    <View android:id="@+id/duration_segment_03" style="@style/DurationRouteSegmentActive" />
                    <View android:id="@+id/duration_segment_04" style="@style/DurationRouteSegmentActive" />
                    <View android:id="@+id/duration_segment_05" style="@style/DurationRouteSegmentActive" />
                    <View android:id="@+id/duration_segment_06" style="@style/DurationRouteSegmentActive" />
                    <View android:id="@+id/duration_segment_07" style="@style/DurationRouteSegmentActive" />
                    <View android:id="@+id/duration_segment_08" style="@style/DurationRouteSegmentActive" />
                    <View android:id="@+id/duration_segment_09" style="@style/DurationRouteSegmentActive" />
                    <View android:id="@+id/duration_segment_10" style="@style/DurationRouteSegmentActive" />
                    <View android:id="@+id/duration_segment_11" style="@style/DurationRouteSegmentInactive" />
                    <View android:id="@+id/duration_segment_12" style="@style/DurationRouteSegmentInactive" />
                    <View android:id="@+id/duration_segment_13" style="@style/DurationRouteSegmentInactive" />
                    <View android:id="@+id/duration_segment_14" style="@style/DurationRouteSegmentInactive" />
                    <View android:id="@+id/duration_segment_15" style="@style/DurationRouteSegmentInactive" />
                    <View android:id="@+id/duration_segment_16" style="@style/DurationRouteSegmentInactive" />
                    <View android:id="@+id/duration_segment_17" style="@style/DurationRouteSegmentInactive" />
                    <View android:id="@+id/duration_segment_18" style="@style/DurationRouteSegmentInactive" />
                    <View android:id="@+id/duration_segment_19" style="@style/DurationRouteSegmentInactive" />
                    <View android:id="@+id/duration_segment_20" style="@style/DurationRouteSegmentInactive" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <FrameLayout
            android:id="@+id/duration_action_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/duration_action_background"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <Button
                android:id="@+id/begin_workout_button"
                style="@style/FluxPrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/duration_start_default"
                android:minHeight="68dp"
                android:text="@string/duration_start_default"
                android:textSize="34sp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
