<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/workout_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/screen_background"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.75"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/region_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/exercise_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="3"
                android:textColor="@color/primary_text"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <android.webkit.WebView
            android:id="@+id/exercise_gif"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="5.75"
            android:background="@android:color/transparent"
            android:contentDescription="@string/exercise_animation_description"
            android:importantForAccessibility="no" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="2.5">

            <Button
                android:id="@+id/start_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:backgroundTint="@color/accent"
                android:text="@string/start"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/countdown_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <TextView
                    android:id="@+id/countdown_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="60"
                    android:textColor="@color/primary_text"
                    android:textSize="70sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/speed_up_button"
                    android:layout_width="76dp"
                    android:layout_height="56dp"
                    android:layout_gravity="end|center_vertical"
                    android:backgroundTint="@color/soft_grey"
                    android:contentDescription="@string/speed_up_description"
                    android:minWidth="0dp"
                    android:text="@string/speed_up"
                    android:textColor="@color/primary_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/rating_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/failed_button"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/failure"
                    android:contentDescription="@string/failed_description"
                    android:text="@string/failed"
                    android:textColor="@color/white"
                    android:textSize="42sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/neutral_button"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/neutral"
                    android:contentDescription="@string/neutral_description"
                    android:text="@string/neutral"
                    android:textColor="@color/white"
                    android:textSize="42sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/completed_button"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/success"
                    android:contentDescription="@string/completed_description"
                    android:text="@string/completed"
                    android:textColor="@color/white"
                    android:textSize="42sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/congratulations_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/congratulations_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✦"
            android:textColor="@color/celebration_gold"
            android:textSize="88sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/congratulations_title"
            android:textColor="@color/white"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/congratulations_message"
            android:textColor="@color/celebration_text"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/congratulations_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/done_button"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="44dp"
            android:backgroundTint="@color/white"
            android:text="@string/done"
            android:textColor="@color/celebration_bottom"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
